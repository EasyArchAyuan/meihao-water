# 美好水业官网 - Caddyfile（Next.js 16 静态导出）
# 站点（canonical 主域）：meihaoshuiye.com / www.meihaoshuiye.com
# 旧域名（301 跳转过来）：廊坊美好水业.online(xn--vhqu7tjwbb1iwpthm1a.online) / www 同 /
#                       meihaowater.site / www.meihaowater.site
#
# 水邻居官网（另一仓库 shuineighbor-water）：
#       linju.meihaowater.site
#
# 图片 CDN（腾讯云 COS 反代）：
#       img.meihaowater.site → 桶 meihao-1256962045（ap-beijing，公共读）

{
	email dev@meihaoshuiye.cn
}

# 共用：安全头 + 分级缓存 + 压缩。两个站点块均 import 复用。
(headers_cache) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
	}

	# 注意：Caddy 中「无 matcher 的 header 块」会覆盖带 matcher 的同名 header，
	# 因此 Cache-Control 全部用带 matcher 的 header 设置，默认值也用 not path 表达。

	# 默认（HTML / RSC 等）：不缓存，每次带 ETag 重验证，内容更新即时生效
	@plain not path /_next/static/* /sitemap.xml /robots.txt /brand/*
	header @plain Cache-Control "no-cache"

	# Next.js 哈希静态资源（文件名含 hash）：长期 immutable
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# sitemap / robots 短缓存
	@meta path /sitemap.xml /robots.txt
	header @meta Cache-Control "public, max-age=3600"

	# 品牌素材 30 天
	@brand path /brand/*
	header @brand Cache-Control "public, max-age=2592000"

	encode zstd gzip
}

# 主站（canonical）：meihaoshuiye.com
# 证书由 Caddy 自动通过 ACME(tls-alpn-01) 签发并续期；
# 前提：DNS A 已指向本机 49.233.87.42 且 443 可达（ACME 校验走 443）。
meihaoshuiye.com, www.meihaoshuiye.com {
	import headers_cache
	root * /var/www/mhsy/out
	file_server
	tls
}

# 旧域名 → 主域名 301 永久跳转（集中百度权重，规避镜像/站群判罚）
xn--vhqu7tjwbb1iwpthm1a.online, www.xn--vhqu7tjwbb1iwpthm1a.online, meihaowater.site, www.meihaowater.site {
	redir https://meihaoshuiye.com{uri} permanent
	tls /etc/ssl/shared/fullchain.pem /etc/ssl/shared/privkey.pem
}

linju.meihaowater.site {
	import headers_cache
	root * /var/www/shuineighbor/out
	file_server
	tls /etc/ssl/shared/fullchain.pem /etc/ssl/shared/privkey.pem
}

# 图片 CDN：反代到腾讯云 COS（img.meihaowater.site）
#
# 为什么用反代而不是直连 COS 默认域名：
#   - 域名短、可控，换桶 / 换区域不影响已发布页面（只改 media.ts 的 CDN 常量）。
#   - 复用现有 *.meihaowater.site 通配证书，零证书配置。
#   - 服务器与 COS 同为 ap-beijing（腾讯云内网），回源流量免费。
#
# 缓存策略（分级）：
#   - certificates / brand：内容相对稳定 → 7 天。
#   - 其余实拍图：文件名即内容标识，改动时换文件名 → 1 天，兼顾更新与省流量。
#
# 注意：Caddy 会自动透传上游的 Content-Type / ETag / Last-Modified，
# 不要手工覆盖 Content-Type（COS 返回的 MIME 是准确的）。
img.meihaowater.site {
	encode zstd gzip
	tls /etc/ssl/shared/fullchain.pem /etc/ssl/shared/privkey.pem

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Access-Control-Allow-Origin "https://meihaowater.site"
	}

	# 授权证书类：长期缓存
	@cert path /company/certificates/*
	header @cert Cache-Control "public, max-age=604800"

	# 其余图片：1 天
	@img not path /company/certificates/*
	header @img Cache-Control "public, max-age=86400"

	reverse_proxy https://meihao-1256962045.cos.ap-beijing.myqcloud.com {
		header_up Host meihao-1256962045.cos.ap-beijing.myqcloud.com
		transport http {
			tls
		}
	}
}