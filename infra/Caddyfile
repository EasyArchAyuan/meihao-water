# 服务 Next.js 16 静态导出产物
# 站点：
#   廊坊美好水业.online（IDN，Punycode: xn--vhqu7tjwbb1iwpthm1a.online）
#   www.廊坊美好水业.online（Punycode: www.xn--vhqu7tjwbb1iwpthm1a.online）
#   meihaowater.site
#   www.meihaowater.site

{
	# Let's Encrypt ACME 账户联系邮箱（证书到期提醒）
	email dev@meihaoshuiye.cn
}

xn--vhqu7tjwbb1iwpthm1a.online, www.xn--vhqu7tjwbb1iwpthm1a.online, meihaowater.site, www.meihaowater.site {
	root * /var/www/mhsy/out

	# Next.js trailingSlash 会生成 /about/index.html
	# Caddy 的 file_server 自动处理：先找 /about → /about/index.html
	file_server

	# 安全 headers
	header {
		# 去除暴露的 server 信息
		-Server
		# XSS / MIME 嗅探保护
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# HSTS（仅 HTTPS 生效）
		Strict-Transport-Security "max-age=31536000"
		# 静态资源缓存（Next.js 自带 hash，不可变）
		Cache-Control "public, max-age=31536000, immutable"
	}

	# sitemap / robots 不缓存太久
	@meta path /sitemap.xml /robots.txt
	header @meta Cache-Control "public, max-age=3600"

	# 品牌素材单独规则：30 天缓存
	@brand path /brand/*
	header @brand Cache-Control "public, max-age=2592000"

	# 启用 gzip/zstd（Caddy 自动处理）
	encode zstd gzip
}
