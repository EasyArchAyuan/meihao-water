# 美好水业官网 - Caddyfile（Next.js 16 静态导出）
# 站点（canonical 主域）：meihaoshuiye.com / www.meihaoshuiye.com
# 旧域名（301 跳转过来）：廊坊美好水业.online(xn--vhqu7tjwbb1iwpthm1a.online) / www 同 /
#                       meihaowater.site / www.meihaowater.site
#
# 水邻居官网（另一仓库 shuineighbor-water）：
#       linju.meihaowater.site
#
# 图片 CDN（腾讯云 COS 反代）：
#       img.meihaowater.site → 桶 meihao-1256962045（ap-beijing，公共读）
{
	email dev@meihaoshuiye.cn

	# 访问 + 运行日志（全站统一，按大小滚动）。
	# 为什么必须有：本站此前完全没有访问日志，一旦出现「百度说连不上、我们自测 200」
	# 这类问题，就只能盲猜。有了它可以直接 grep Baiduspider 确认抓取是否真的落到服务器：
	#   查百度抓取： grep -i baiduspider /var/log/caddy/access.log | tail
	#   查百度是否抓到首页（HTML 标签验证用的就是首页）：
	#     grep -i baiduspider /var/log/caddy/access.log | grep -E 'uri":"/"' | tail
	#
	# ⚠️⚠️ 关键：全局 `log` 选项**只配置默认 logger 的输出地址，并不会开启访问日志**！
	#    实测（2026-09-22）只加这一段，access.log 里只有运行日志、**0 条访问记录**。
	#    必须在**每个站点块**里另写一条**裸 `log`**（见下方各块），访问日志才会落到这里。
	#    裸 `log` 会写入「默认 logger」，也就是本文件的 output —— 所有站点共用同一个
	#    writer，滚动状态统一，不会出现多个 writer 抢同一文件导致轮转错乱。
	#    代价：运行日志也在这个文件里（`grep '"logger":"http.log.access"'` 可只取访问记录）。
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}

# ⚠️ 2026-09-22 起站长的验证改用百度「HTML 标签验证」
#   （<meta name="baidu-site-verification" content="codeva-…" />，见 src/app/layout.tsx），
#   文件验证及其 `(verifyfile)` 片段已一并移除，站点块里不再有百度验证文件的专门处理。
#
# 历史教训（保留备查：将来若重新启用文件验证，必须照此实现）——
#   **绝不能用 file_server 托管验证文件**：file_server 会给文件加 `ETag` / `Last-Modified`，
#   检测端第二次访问带 `If-None-Match` / `If-Modified-Since` 时，Caddy 回 **304 Not Modified**；
#   而 **304 属于 3xx**，站长平台把 3xx 一律判为跳转，报错文案就是「302 网页存在跳转」
#   ——哪怕服务器访问日志里蜘蛛拿到的确实是 200（两边都没说谎，是**条件请求**造成的视角差）。
#   正解：用 `respond` 恒定 200 并显式 `no-store`（respond 不产生 ETag / Last-Modified，
#   从根上切断条件请求链路）。
#   ⚠️ 另外：片段必须定义在**使用点之前** —— Caddy 的 `import` 不支持前向引用，
#      定义在后会报 `File to import not found: <片段名>`（2026-09-22 实测）。

# HTTP(80) → HTTPS：显式改成 301，替代 Caddy 默认的 308。
#
# 为什么必须改（百度专项）：
#   - 百度官方只认 301 表示「永久重定向」；308 是 RFC 7538 的较新状态码，
#     Baiduspider 与百度站长平台的部分组件对 308 兼容性差，可能直接放弃跟随，
#     在站长平台上就表现为「无法连接到您网站的服务器」。
#   - 国内 SEO 实务：只认 301 / 302，不要用 307 / 308。
#
# ⚠️ 必须**显式列出 hostname**。实测（2026-09-22）：只写不带 host 的 `http://` **不会**
#    覆盖自动跳转 —— Caddy 会另建一个 `remaining_auto_https_redirects` 服务器，按 host
#    匹配且优先命中，结果仍是 308。只有把 hostname 写进 HTTP 站点地址，Caddy 才会
#    把该 host 的 HTTP 交给这里处理、不再生成自动跳转。
#
# 例外：各厂商的「根目录校验文件」在 80 端口直出、不做跳转。
#   目的：这类文件（站点归属校验，内容为公开校验串，明文传输无风险）
#   不依赖 443 的 TLS 握手，可绕开证书信任库差异造成的校验失败。
#   注意：百度已改用 HTML 标签验证，`/baidu_verify_*.html` **不要**再放进 file_server
#   （会踩 304 陷阱，见上方历史教训）；若将来重新启用，请另写 `respond` 处理块。
http://meihaoshuiye.com, http://www.meihaoshuiye.com, http://meihaowater.site, http://www.meihaowater.site, http://xn--vhqu7tjwbb1iwpthm1a.online, http://www.xn--vhqu7tjwbb1iwpthm1a.online, http://linju.meihaowater.site {
	# 开启 80 端口访问日志 —— 百度验证/抓取很可能先走 HTTP，这里能看到它到底有没有来
	log

	# 其它厂商验证文件（Google/Bing/搜狗/360）：走文件
	@verify {
		host meihaoshuiye.com www.meihaoshuiye.com
		path /google*.html /BingSiteAuth.xml /sogou_verify_*.html /360_verify_*.html /so_verify_*.html
	}
	handle @verify {
		root * /var/www/mhsy/out
		file_server
	}

	# 旧域：HTTP 直接跳 canonical 主域，省掉「→https 旧域→301 主域」两跳
	@legacy host meihaowater.site www.meihaowater.site xn--vhqu7tjwbb1iwpthm1a.online www.xn--vhqu7tjwbb1iwpthm1a.online
	handle @legacy {
		redir https://meihaoshuiye.com{uri} permanent
	}

	handle {
		redir https://{host}{uri} permanent
	}
}

# 共用：安全头 + 分级缓存 + 压缩。两个站点块均 import 复用。
(headers_cache) {
	# 裸 `log` = 开启本站点块的访问日志，写入全局默认 logger（/var/log/caddy/access.log）。
	# 少了这一行就**没有访问日志**（全局 `log` 选项不负责开启），详见全局块注释。
	log

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
	}

	# 注意：Caddy 中「无 matcher 的 header 块」会覆盖带 matcher 的同名 header，
	# 因此 Cache-Control 全部用带 matcher 的 header 设置，默认值也用 not path 表达。

	# 默认（HTML / RSC 等）：不缓存，每次带 ETag 重验证，内容更新即时生效
	@plain not path /_next/static/* /sitemap.xml /robots.txt /brand/*
	header @plain Cache-Control "no-cache"

	# Next.js 哈希静态资源（文件名含 hash）：长期 immutable
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# sitemap / robots 短缓存
	@meta path /sitemap.xml /robots.txt
	header @meta Cache-Control "public, max-age=3600"

	# 品牌素材 30 天
	@brand path /brand/*
	header @brand Cache-Control "public, max-age=2592000"

	encode zstd gzip
}

# 主站（canonical）：meihaoshuiye.com
# 证书由 Caddy 自动通过 ACME(tls-alpn-01) 签发并续期 —— Caddy 默认即自动 HTTPS。
# ⚠️ 本块无需 tls 指令；切勿写裸 `tls`（Caddyfile 语法要求 tls 必须带参数，否则 validate 失败）。
# 前提：DNS A 已指向本机 49.233.87.42 且 443 可达（ACME 校验走 443）。
meihaoshuiye.com, www.meihaoshuiye.com {
	import headers_cache
	root * /var/www/mhsy/out

	handle {
		file_server
	}
}

# 旧域名 → 主域名 301 永久跳转（集中百度权重，规避镜像/站群判罚）
xn--vhqu7tjwbb1iwpthm1a.online, www.xn--vhqu7tjwbb1iwpthm1a.online, meihaowater.site, www.meihaowater.site {
	log
	redir https://meihaoshuiye.com{uri} permanent
	tls /etc/ssl/shared/fullchain.pem /etc/ssl/shared/privkey.pem
}

linju.meihaowater.site {
	import headers_cache
	root * /var/www/shuineighbor/out
	file_server
	tls /etc/ssl/shared/fullchain.pem /etc/ssl/shared/privkey.pem
}

# 图片 CDN：反代到腾讯云 COS（img.meihaowater.site）
#
# 为什么用反代而不是直连 COS 默认域名：
#   - 域名短、可控，换桶 / 换区域不影响已发布页面（只改 media.ts 的 CDN 常量）。
#   - 复用现有 *.meihaowater.site 通配证书，零证书配置。
#   - 服务器与 COS 同为 ap-beijing（腾讯云内网），回源流量免费。
#
# 缓存策略（分级）：
#   - certificates / brand：内容相对稳定 → 7 天。
#   - 其余实拍图：文件名即内容标识，改动时换文件名 → 1 天，兼顾更新与省流量。
#
# 注意：Caddy 会自动透传上游的 Content-Type / ETag / Last-Modified，
# 不要手工覆盖 Content-Type（COS 返回的 MIME 是准确的）。
img.meihaowater.site {
	log
	encode zstd gzip
	tls /etc/ssl/shared/fullchain.pem /etc/ssl/shared/privkey.pem

	# COS 桶防盗链白名单以 meihaowater.site 为准；官网主域已翻转为 meihaoshuiye.com。
	# 对来自自有域名（主域/www/水邻居子域/IDN 旧域）的请求，把 Referer 规范为白名单值，
	# 避免自家页面取图被 COS 返回 403；第三方站点直链仍按自身 Referer 校验，防盗链不受影响。
	@selfref header_regexp Referer ^https?://([^./]+\.)*(meihaoshuiye\.com|meihaowater\.site|xn--vhqu7tjwbb1iwpthm1a\.online)(:[0-9]+)?(/|$)
	request_header @selfref Referer "https://meihaowater.site/"

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Access-Control-Allow-Origin "https://meihaowater.site"
	}

	# 授权证书类：长期缓存
	@cert path /company/certificates/*
	header @cert Cache-Control "public, max-age=604800"

	# 其余图片：1 天
	@img not path /company/certificates/*
	header @img Cache-Control "public, max-age=86400"

	reverse_proxy https://meihao-1256962045.cos.ap-beijing.myqcloud.com {
		header_up Host meihao-1256962045.cos.ap-beijing.myqcloud.com
		transport http {
			tls
		}
	}
}
